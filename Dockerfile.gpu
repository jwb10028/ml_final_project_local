# Use Miniconda as a base so we can install cudatoolkit + TF-GPU into a py37 env
FROM continuumio/miniconda3:4.12.0

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# 1) Create a Python 3.7 conda env with GPU support
RUN conda update -n base -c defaults conda -y && \
    conda create -n py37 \
      python=3.7 \
      cudatoolkit=11.2 \
      tensorflow-gpu=2.11 \
      matplotlib \
      librosa \
      crepe \
    -y && \
    conda clean -afy

# 2) Activate that env by default for all following RUNs (including the final CMD)
SHELL ["conda", "run", "-n", "py37", "/bin/bash", "-lc"]

# 3) Install Jupyter, core DDSP, and the full magenta/ddsp repo (for ddsp.training)
RUN pip install --upgrade pip && \
    pip install jupyter ddsp==1.6.5 && \
    git clone https://github.com/magenta/ddsp.git /ddsp-full && \
    pip install -e /ddsp-full

# 4) (Optional) register this env as a notebook kernel so VSCode / Jupyter UI can see it
RUN python -m ipykernel install --user --name py37-ddsp \
    --display-name "Python 3.7 (DDSP GPU)"

# 5) Expose /workspace for mounting your project files
WORKDIR /workspace
EXPOSE 8888

# 6) Launch Jupyter in one valid CMD instruction
CMD ["jupyter", "notebook", \
     "--ip=0.0.0.0", \
     "--port=8888", \
     "--allow-root", \
     "--NotebookApp.token=''", \
     "--NotebookApp.disable_check_xsrf=True"]
